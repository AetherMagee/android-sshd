<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.aethermagee.sshd">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="SSH approvals" android:icon="@android:drawable/ic_lock_lock">
        <!-- Prompts come from android-sshd (root) via `am broadcast`. Root
             passes any permission check; DUMP keeps ordinary apps out. -->
        <receiver
            android:name=".PromptReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name=".DecisionReceiver" android:exported="false" />
    </application>
</manifest>
